pendencies, click the\n\"Open Examples\" button below.\n\u001b[0;31m---------------------------------------------------------------------------\u001b[0m\n"],"errorDetails":{"actions":[{"action":"open_url","actionText":"Open Examples","url":"/notebooks/snippets/importing_libraries.ipynb"}]}}],"source":["##agent\n","# === agent.py ===\n","# Drop this whole cell into a Colab notebook cell or save as src/agent.py\n","# Requires: langchain, openai, qdrant-client, requests, python-dotenv, guardrails.py in project.\n","\n","import os\n","import json\n","import time\n","from typing import List, Dict, Any, Optional, Tuple\n","\n","from dotenv import load_dotenv\n","\n","# LangChain imports (v1 style)\n","from langchain_openai import ChatOpenAI\n","from langchain_openai import OpenAIEmbeddings\n","from langchain.vectorstores import Qdrant\n","from langchain.chains import RetrievalQA\n","from langchain.prompts import PromptTemplate\n","from langchain.schema import Document\n","\n","from qdrant_client import QdrantClient, models\n","from qdrant_client.http.exceptions import UnexpectedResponse\n","\n","import requests\n","import logging\n","\n","# Import your guardrails module (must be in notebook or project root)\n","from guardrails import validate_input, sanitize_output\n","\n","load_dotenv()  # loads .env from project root\n","\n","# Setup logging\n","logging.basicConfig(level=logging.INFO)\n","logger = logging.getLogger(__name__)\n","\n","\n","# -------- CONFIG (read from .env) ----------\n","OPENAI_API_KEY: Optional[str] = os.getenv(\"OPENAI_API_KEY\")\n","OPENAI_API_BASE: Optional[str] = os.getenv(\"OPENAI_API_BASE\") or None\n","EMBED_MODEL: str = os.getenv(\"EMBED_MODEL\", \"text-embedding-3-small\")\n","LLM_MODEL: str = os.getenv(\"LLM_MODEL\", \"gpt-4o-mini\")\n","LLM_TEMPERATURE: float = float(os.getenv(\"LLM_TEMPERATURE\", \"0.0\"))\n","\n","QDRANT_URL: str = os.getenv(\"QDRANT_URL\", \"http://localhost:6333\")\n","QDRANT_API_KEY: Optional[str] = os.getenv(\"QDRANT_API_KEY\", None)\n","QDRANT_COLLECTION: str = os.getenv(\"QDRANT_COLLECTION\", \"jee_math_kb\")\n","TOP_K: int = int(os.getenv(\"TOP_K\", \"5\"))\n","SIMILARITY_THRESHOLD: float = float(os.getenv(\"SIMILARITY_THRESHOLD\", \"0.78\"))\n","\n","SERPER_API_KEY: Optional[str] = os.getenv(\"SERPER_API_KEY\", None)\n","MCP_SERVER_URL: Optional[str] = os.getenv(\"MCP_SERVER_URL\", None)\n","MCP_API_KEY: Optional[str] = os.getenv(\"MCP_API_KEY\", None)\n","\n","# -------- Helpers: init clients ----------\n","def init_openai_clients() -> Tuple[ChatOpenAI, OpenAIEmbeddings]:\n","    \"\"\"Initialize LangChain LLM + embeddings. Returns (llm, embeddings).\"\"\"\n","    # OpenAIEmbeddings uses OPENAI_API_KEY in env by default\n","    emb = OpenAIEmbeddings(model=EMBED_MODEL)\n","    llm = ChatOpenAI(model=LLM_MODEL, temperature=LLM_TEMPERATURE)\n","    return llm, emb\n","\n","def init_qdrant_vectorstore(embeddings: OpenAIEmbeddings) -> Tuple[Optional[Qdrant], Optional[QdrantClient]]:\n","    \"\"\"\n","    Connect to Qdrant and return a LangChain Qdrant vectorstore wrapper.\n","    If the collection doesn't exist, return (None, client) so caller can seed it.\n","    \"\"\"\n","    try:\n","        client = QdrantClient(url=QDRANT_URL, api_key=QDRANT_API_KEY)\n","        # Check if collection exists\n","        try:\n","            # Use a more robust check like count\n","            count_result = client.count(collection_name=QDRANT_COLLECTION, exact=False)\n","            logger.info(f\"[agent] Qdrant collection '{QDRANT_COLLECTION}' found with {count_result.count} items.\")\n","            collection_exists = True\n","        except UnexpectedResponse as e:\n","             if e.status_code == 404:\n","                 collection_exists = False\n","                 logger.warning(f\"[agent] Qdrant collection '{QDRANT_COLLECTION}' not found.\")\n","             else:\n","                 logger.error(f\"[agent] Error checking Qdrant collection {QDRANT_COLLECTION}: {e}\")\n","                 return None, client # Return client even on error\n","        except Exception as e:\n","            logger.error(f\"[agent] Unexpected error checking Qdrant collection: {e}\")\n","            return None, client # Return client even on error\n","\n","\n","        if not collection_exists:\n","            logger.warning(f\"[agent] Qdrant collection '{QDRANT_COLLECTION}' not found. Seed KB first (use kb_builder).\")\n","            return None, client\n","\n","        vectorstore = Qdrant(client=client, collection_name=QDRANT_COLLECTION, embeddings=embeddings)\n","        return vectorstore, client\n","    except Exception as e:\n","        logger.error(f\"Failed to initialize Qdrant client: {e}\")\n","        return None, None\n","\n","\n","# -------- Prompt templates ----------\n","MATH_PROMPT = PromptTemplate.from_template(\n","    \"\"\"You are a clear, patient JEE-level mathematics professor. Given context and a question, produce a step-by-step solution,\n","showing intermediate steps and a final boxed answer. Use clear numbering for steps. If you used sources, list them at the end.\n","\n","Context:\n","{context}\n","\n","Question:\n","{question}\n","\n","Solution (step-by-step):\n","\"\"\"\n",")\n","\n","WEB_PROMPT = PromptTemplate.from_template(\n","    \"\"\"You are a JEE-level mathematics professor. Use the web context below as supporting material and produce a clear, step-by-step solution.\n","If the web context conflicts or is insufficient, say so. Cite source URLs at the end.\n","\n","Web context:\n","{context}\n","\n","Question:\n","{question}\n","\n","Solution (step-by-step):\n","\"\"\"\n",")\n","\n","# -------- Web search (Serper) + MCP wrapper ----------\n","def serper_search(query: str, num: int = 5) -> List[Dict[str, Any]]:\n","    \"\"\"\n","    Call Serper API (serper.dev) if SERPER_API_KEY provided.\n","    Returns a list of hits: {title, link, snippet}\n","    If no API key, returns empty list.\n","    \"\"\"\n","    if not SERPER_API_KEY:\n","        logger.warning(\"SERPER_API_KEY not configured. Skipping web search.\")\n","        return []\n","    url = \"https://google.serper.dev/search\"\n","    headers = {\"X-API-KEY\": SERPER_API_KEY, \"Content-Type\": \"application/json\"}\n","    payload = {\"q\": query, \"num\": num}\n","    try:\n","        resp = requests.post(url, headers=headers, json=payload, timeout=10)\n","        resp.raise_for_status()\n","        data = resp.json()\n","        organic = data.get(\"organic\", [])\n","        hits = []\n","        for hit in organic[:num]:\n","            hits.append({\n","                \"title\": hit.get(\"title\"),\n","                \"link\": hit.get(\"link\"),\n","                \"snippet\": hit.get(\"snippet\")\n","            })\n","        return hits\n","    except requests.exceptions.RequestException as e:\n","        logger.error(f\"serper_search error: {e}\")\n","        return []\n","    except Exception as e:\n","        logger.error(f\"Unexpected error during serper_search: {e}\")\n","        return []\n","\n","\n","def mcp_extract(sources: List[Dict[str, str]]) -> List[Dict[str, str]]:\n","    \"\"\"\n","    Send sources to an MCP server (if configured) to get structured extraction.\n","    If MCP not configured, return the input 'sources' as-is (sanitized).\n","    \"\"\"\n","    if not MCP_SERVER_URL:\n","        logger.info(\"MCP_SERVER_URL not configured. Using local fallback for extraction.\")\n","        # simple sanitization fallback\n","        return [{\"title\": s.get(\"title\"), \"url\": s.get(\"link\"), \"snippet\": s.get(\"snippet\")} for s in sources]\n","    payload = {\"sources\": sources}\n","    headers = {\"Content-Type\": \"application/json\"}\n","    if MCP_API_KEY:\n","        headers[\"Authorization\"] = f\"Bearer {MCP_API_KEY}\"\n","    try:\n","        r = requests.post(f\"{MCP_SERVER_URL.rstrip('/')}/extract\", json=payload, headers=headers, timeout=10)\n","        r.raise_for_status()\n","        return r.json()\n","    except requests.exceptions.RequestException as e:\n","        logger.error(f\"mcp_extract error: {e}. Falling back to local extraction.\")\n","        return [{\"title\": s.get(\"title\"), \"url\": s.get(\"link\"), \"snippet\": s.get(\"snippet\")} for s in sources]\n","    except Exception as e:\n","        logger.error(f\"Unexpected error during mcp_extract: {e}. Falling back to local extraction.\")\n","        return [{\"title\": s.get(\"title\"), \"url\": s.get(\"link\"), \"snippet\": s.get(\"snippet\")} for s in sources]\n","\n","\n","# -------- Core agent functionality ----------\n","class MathRAGAgent:\n","    def __init__(self):\n","        self.llm, self.emb = init_openai_clients()\n","        self.vectorstore, self.qclient = init_qdrant_vectorstore(self.emb)\n","        self.retriever = None\n","        if self.vectorstore:\n","            self.retriever = self.vectorstore.as_retriever(search_kwargs={\"k\": TOP_K})\n","        else:\n","            logger.warning(\"Vectorstore not initialized. KB retrieval will not be available.\")\n","\n","\n","    def _kb_hit_confident(self, docs: List[Document]) -> bool:\n","        \"\"\"\n","        Simple heuristic: if retriever returned some docs, consider it a hit.\n","        You can improve this by inspecting payload distances or doing an LLM check.\n","        \"\"\"\n","        return bool(docs and len(docs) > 0)\n","\n","    def synthesize_from_kb(self, question: str, docs: List[Document]) -> str:\n","        \"\"\"\n","        Compose a context from retrieved docs and ask LLM to produce step-by-step.\n","        \"\"\"\n","        ctx_items = []\n","        for d in docs:\n","            meta = getattr(d, \"metadata\", {}) or {}\n","            src = meta.get(\"source\") or meta.get(\"source_url\") or meta.get(\"orig_source\") or \"\"\n","            text = d.page_content if hasattr(d, \"page_content\") else str(d)\n","            ctx_items.append(f\"Source: {src}\\n{text}\")\n","        context = \"\\n\\n---\\n\\n\".join(ctx_items)[:30000]\n","        prompt = MATH_PROMPT.format(context=context, question=question)\n","        try:\n","            resp = self.llm.generate([{\"role\": \"user\", \"content\": prompt}])\n","            out = resp.generations[0][0].text\n","            return out\n","        except Exception as e:\n","            logger.error(f\"Error during KB synthesis: {e}\")\n","            return f\"Error generating solution from KB: {e}\"\n","\n","\n","    def synthesize_from_web(self, question: str, web_sources: List[Dict[str, str]]) -> str:\n","        ctx_items = []\n","        for s in web_sources:\n","            title = s.get(\"title\") or \"\"\n","            snippet = s.get(\"snippet\") or \"\"\n","            url = s.get(\"url\") or s.get(\"link\") or \"\"\n","            ctx_items.append(f\"{title}: {snippet} (source: {url})\")\n","        context = \"\\n\\n\".join(ctx_items)[:30000]\n","        prompt = WEB_PROMPT.format(context=context, question=question)\n","        try:\n","            resp = self.llm.generate([{\"role\": \"user\", \"content\": prompt}])\n","            out = resp.generations[0][0].text\n","            return out\n","        except Exception as e:\n","            logger.error(f\"Error during web synthesis: {e}\")\n","            return f\"Error generating solution from web sources: {e}\"\n","\n","\n","    # Optional helper to upsert a verified answer into the KB (after human feedback)\n","    def upsert_verified_solution(self, question: str, solution_text: str, metadata: Optional[Dict[str, Any]] = None):\n","        \"\"\"\n","        Add a new document to the Qdrant KB so future queries may retrieve it.\n","        \"\"\"\n","        if not self.vectorstore:\n","            logger.error(\"Vectorstore not initialized. Cannot upsert document.\")\n","            raise RuntimeError(\"Vectorstore not initialized. Seed Qdrant collection first.\")\n","        doc = Document(page_content=f\"Q: {question}\\n\\nA: {solution_text}\", metadata=metadata or {\"source\": \"agent_verified\"})\n","        try:\n","            self.vectorstore.add_documents([doc])\n","            logger.info(f\"Successfully upserted verified solution for question: {question[:50]}...\")\n","            return True\n","        except Exception as e:\n","            logger.error(f\"Error upserting document to vectorstore: {e}\")\n","            return False"]},{"cell_type":"markdown","metadata":{"id":"3e551321"},"source":["# RAG Knowledge Base Setup\n","\n","This section covers setting up the vector store and embedding model for the RAG system."]},{"cell_type":"code","execution_count":null,"metadata":{"id":"1GO03QsRw3RF"},"outputs":[],"source":["#Data\n","import pandas as pd\n","\n","def load_jeebench_dataset():\n","    df = pd.read_json(\"hf://datasets/daman1209arora/jeebench/test.json\")\n","    df = df[df[\"subject\"].str.lower() == \"math\"]\n","    return df[['question', 'gold']]\n","\n","if __name__ == \"__main__\":\n","    load_jeebench_dataset()"]},{"cell_type":"code","source":["# === KB SEEDING: Load JEE Math Dataset and Index into Qdrant ===\n","import os\n","from datasets import load_dataset\n","import pandas as pd\n","from langchain.schema import Document\n","from langchain.text_splitter import RecursiveCharacterTextSplitter\n","from langchain_openai import OpenAIEmbeddings\n","from langchain.vectorstores import Qdrant\n","from qdrant_client import QdrantClient, models\n","import logging\n","\n","logging.basicConfig(level=logging.INFO)\n","logger = logging.getLogger(__name__)\n","\n","logger.info('\\n=== KB SEEDING START ===')\n","\n","# CONFIG\n","QDRANT_URL = os.getenv('QDRANT_URL', ':memory:')\n","QDRANT_API_KEY = os.getenv('QDRANT_API_KEY')\n","QDRANT_COLLECTION = os.getenv('QDRANT_COLLECTION', 'jee_math_kb')\n","EMBED_MODEL = os.getenv('EMBED_MODEL', 'text-embedding-3-small')\n","\n","logger.info(f'Collection: {QDRANT_COLLECTION}')\n","logger.info(f'Qdrant URL: {QDRANT_URL}')\n","\n","# Step 1: Load dataset\n","logger.info('\\n[1/5] Loading JEE Bench dataset...')\n","try:\n","    dataset = load_dataset('daman1209arora/jeebench', split='test', cache_dir='/tmp/jeebench')\n","    df = pd.DataFrame(dataset)\n","    df_math = df[df['subject'].str.lower() == 'math'].reset_index(drop=True)\n","    logger.info(f'Loaded {len(df_math)} math questions')\n","except Exception as e:\n","    logger.warning(f'HuggingFace load failed: {e}. Using sample data...')\n","    df_math = pd.DataFrame([\n","        {'question': 'Solve x^2 - 5x + 6 = 0', 'gold': 'x = 2 or x = 3'},\n","        {'question': 'Find derivative of sin(x)', 'gold': 'cos(x)'},\n","        {'question': 'Integral of e^x', 'gold': 'e^x + C'},\n","    ])\n","    logger.info(f'Using {len(df_math)} sample questions')\n","\n","# Step 2: Build documents\n","logger.info('\\n[2/5] Building documents from Q&A pairs...')\n","documents = []\n","for idx, row in df_math.iterrows():\n","    q = str(row.get('question', ''))\n","    a = str(row.get('gold', ''))\n","    if q and a:\n","        doc = Document(\n","            page_content=f'Q: {q}\\nA: {a}',\n","            metadata={'source': 'jeebench', 'idx': idx}\n","        )\n","        documents.append(doc)\n","logger.info(f'Created {len(documents)} documents')\n","\n","# Step 3: Chunk\n","logger.info('\\n[3/5] Chunking documents...')\n","splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=100)\n","chunked = splitter.split_documents(documents)\n","logger.info(f'Created {len(chunked)} chunks')\n","\n","# Step 4: Embeddings\n","logger.info('\\n[4/5] Initializing embeddings...')\n","embeddings = OpenAIEmbeddings(model=EMBED_MODEL)\n","logger.info('✅ Embeddings ready')\n","\n","# Step 5: Qdrant seeding\n","logger.info('\\n[5/5] Seeding Qdrant KB...')\n","try:\n","    # Use in-memory client as default for Colab\n","    client = QdrantClient(':memory:') if QDRANT_URL == ':memory:' else QdrantClient(url=QDRANT_URL, api_key=QDRANT_API_KEY)\n","\n","    try:\n","        # Check if collection exists before attempting deletion\n","        client.get_collection(QDRANT_COLLECTION)\n","        client.delete_collection(QDRANT_COLLECTION)\n","        logger.info(f'Deleted existing collection: {QDRANT_COLLECTION}')\n","    except Exception as e:\n","        logger.info(f'Collection {QDRANT_COLLECTION} not found or could not be deleted: {e}')\n","\n","\n","    client.create_collection(\n","        collection_name=QDRANT_COLLECTION,\n","        vectors_config=models.VectorParams(size=1536, distance=models.Distance.COSINE),\n","    )\n","    logger.info(f'Created collection: {QDRANT_COLLECTION}')\n","\n","    vectorstore = Qdrant(client=client, collection_name=QDRANT_COLLECTION, embeddings=embeddings)\n","    vectorstore.add_documents(chunked, batch_size=10)\n","\n","    logger.info('\\n✅ KB SEEDING COMPLETE!')\n","    logger.info(f'Collection: {QDRANT_COLLECTION}')\n","    logger.info(f'Documents: {len(chunked)}')\n","    logger.info('='*60)\n","\n","except Exception as e:\n","    logger.error(f'Seeding failed: {e}')\n","    raise"],"metadata":{"id":"lSbJYm9vfND8","colab":{"base_uri":"https://localhost:8080/","height":383},"executionInfo":{"status":"error","timestamp":1764081815537,"user_tz":-330,"elapsed":1355,"user":{"displayName":"Abhinav Kotar","userId":"00398493030369487425"}},"outputId":"63280630-f45c-4bfc-dfdf-841451058d3d"},"execution_count":null,"outputs":[{"output_type":"error","ename":"ModuleNotFoundError","evalue":"No module named 'langchain.schema'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mModuleNotFoundError\u001b[0m                       Traceback (most recent call last)","\u001b[0;32m/tmp/ipython-input-248991543.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      3\u001b[0m \u001b[0;32mfrom\u001b[0m \u001b[0mdatasets\u001b[0m \u001b[0;32mimport\u001b[0m \u001b[0mload_dataset\u001b