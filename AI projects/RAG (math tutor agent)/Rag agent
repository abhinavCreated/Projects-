=======\n","INITIALIZING MATH RAG AGENT\n","============================================================\n","\n","❌ Import Error: No module named 'agent'\n","Make sure agent.py and guardrails.py are available and requirements are installed.\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"V9rgP5e0dWMs"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"73f2cb64"},"source":["##Web search (*MCP* *module*)\n","\n","\n"]},{"cell_type":"code","metadata":{"id":"vBzDfVBE9yVx"},"source":["# web_search_mcp.py\n","# === Web Search MCP Module with Serper API Integration ===\n","# Requires: requests, python-dotenv, openai, langchain\n","\n","import os\n","import requests\n","import json\n","from typing import List, Dict, Any, Optional, Tuple\n","from datetime import datetime\n","from google.colab import userdata\n","import logging\n","\n","# Setup logging\n","logging.basicConfig(level=logging.DEBUG)\n","logger = logging.getLogger(__name__)\n","\n","\n","# ============================================================================\n","# SERPER API INTEGRATION\n","# ============================================================================\n","\n","class SerperSearchClient:\n","    \"\"\"Wrapper for Serper.dev API to perform Google searches.\"\"\"\n","\n","    def __init__(self, api_key: Optional[str] = None):\n","        \"\"\"Initialize Serper client with API key from secrets or env.\"\"\"\n","        self.api_key = api_key or os.environ.get('SERPER_API_KEY')\n","        if not self.api_key:\n","            try:\n","                self.api_key = userdata.get('SERPER_API_KEY')\n","            except:\n","                logger.warning(\"SERPER_API_KEY not found in secrets or environment\")\n","                self.api_key = None\n","\n","        self.base_url = \"https://google.serper.dev/search\"\n","        self.timeout = 10\n","\n","    def search(self, query: str, num_results: int = 5) -> List[Dict[str, Any]]:\n","        \"\"\"\n","        Perform a Google search via Serper API.\n","        Returns list of results with title, link, snippet.\n","        \"\"\"\n","        if not self.api_key:\n","            logger.error(\"Serper API key not configured\")\n","            return []\n","\n","        try:\n","            headers = {\n","                \"X-API-KEY\": self.api_key,\n","                \"Content-Type\": \"application/json\"\n","            }\n","            payload = {\n","                \"q\": query,\n","                \"num\": num_results,\n","                \"gl\": \"us\",\n","                \"hl\": \"en\"\n","            }\n","\n","            response = requests.post(\n","                self.base_url,\n","                headers=headers,\n","                json=payload,\n","                timeout=self.timeout\n","            )\n","            response.raise_for_status()\n","            data = response.json()\n","\n","            # Extract organic search results\n","            organic = data.get(\"organic\", [])\n","            results = []\n","            for hit in organic[:num_results]:\n","                results.append({\n","                    \"title\": hit.get(\"title\", \"\"),\n","                    \"link\": hit.get(\"link\", \"\"),\n","                    \"snippet\": hit.get(\"snippet\", \"\"),\n","                    \"position\": hit.get(\"position\", 0)\n","                })\n","\n","            logger.info(f\"Serper search for '{query}' returned {len(results)} results\")\n","            return results\n","\n","        except requests.exceptions.RequestException as e:\n","            logger.error(f\"Serper API error: {e}\")\n","            return []\n","        except Exception as e:\n","            logger.error(f\"Unexpected error in Serper search: {e}\")\n","            return []\n","\n","# ============================================================================\n","# MCP EXTRACTION & STRUCTURING\n","# ============================================================================\n","\n","class MCPExtractor:\n","    \"\"\"Extract and structure web search results via MCP-style processing.\"\"\"\n","\n","    def __init__(self, mcp_server_url: Optional[str] = None):\n","        \"\"\"\n","        Initialize MCP extractor.\n","        If mcp_server_url provided, uses remote MCP server.\n","        Otherwise, uses local fallback sanitization.\n","        \"\"\"\n","        self.mcp_server_url = mcp_server_url\n","        self.timeout = 5\n","\n","    def extract_structured_context(self, sources: List[Dict[str, str]]) -> List[Dict[str, Any]]:\n","        \"\"\"\n","        Send sources to MCP server for extraction,\n","        or fallback to local sanitization.\n","        Returns list of structured sources with metadata.\n","        \"\"\"\n","        if self.mcp_server_url:\n","            return self._extract_via_mcp(sources)\n","        else:\n","            return self._extract_local_fallback(sources)\n","\n","    def _extract_via_mcp(self, sources: List[Dict[str, str]]) -> List[Dict[str, Any]]:\n","        \"\"\"Call remote MCP server to extract and structure content.\"\"\"\n","        try:\n","            payload = {\"sources\": sources}\n","            headers = {\"Content-Type\": \"application/json\"}\n","\n","            response = requests.post(\n","                f\"{self.mcp_server_url}/extract\",\n","                headers=headers,\n","                json=payload,\n","                timeout=self.timeout\n","            )\n","            response.raise_for_status()\n","            structured = response.json().get(\"extracted\", [])\n","            logger.info(f\"MCP extracted {len(structured)} sources\")\n","            return structured\n","\n","        except Exception as e:\n","            logger.warning(f\"MCP extraction failed: {e}, falling back to local\")\n","            return self._extract_local_fallback(sources)\n","\n","    def _extract_local_fallback(self, sources: List[Dict[str, str]]) -> List[Dict[str, Any]]:\n","        \"\"\"Local fallback: sanitize and structure sources without MCP.\"\"\"\n","        structured = []\n","        for source in sources:\n","            structured.append({\n","                \"title\": source.get(\"title\", \"\"),\n","                \"url\": source.get(\"link\", \"\"),\n","                \"snippet\": source.get(\"snippet\", \"\"),\n","                \"summary\": self._clean_snippet(source.get(\"snippet\", \"\")),\n","                \"source_type\": \"web\",\n","                \"extracted_at\": datetime.now().isoformat(),\n","                \"metadata\": {\n","                    \"authority_signal\": self._estimate_authority(source.get(\"link\", \"\")),\n","                    \"relevance_score\": 0.8\n","                }\n","            })\n","        return structured\n","\n","    def _clean_snippet(self, snippet: str, max_len: int = 300) -> str:\n","        \"\"\"Clean and truncate snippet for readability.\"\"\"\n","        snippet = snippet.replace(\"\\xa0\", \" \").strip()\n","        if len(snippet) > max_len:\n","            snippet = snippet[:max_len] + \"...\"\n","        return snippet\n","\n","    def _estimate_authority(self, url: str) -> float:\n","        \"\"\"Simple heuristic: estimate source authority based on domain.\"\"\"\n","        trusted_domains = [\"edu\", \"gov\", \"org\", \"ac.uk\", \"springer\", \"ieee\", \"acm\"]\n","        for domain in trusted_domains:\n","            if domain in url.lower():\n","                return 0.9\n","        return 0.6\n","\n","# ============================================================================\n","# WEB SEARCH AGENT (Router)\n","# ============================================================================\n","\n","class WebSearchAgent:\n","    \"\"\"\n","    High-level agent that coordinates Serper search + MCP extraction.\n","    Acts as a router for web-based retrieval fallback.\n","    \"\"\"\n","\n","    def __init__(self, serper_api_key: Optional[str] = None, mcp_server_url: Optional[str] = None):\n","        self.serper_client = SerperSearchClient(api_key=serper_api_key)\n","        self.mcp_extractor = MCPExtractor(mcp_server_url=mcp_server_url)\n","        self.logger = logger\n","\n","    def search_and_extract(self, query: str, num_results: int = 5) -> Tuple[List[Dict[str, Any]], bool]:\n","        \"\"\"\n","        Orchestrate: search via Serper -> extract via MCP -> return structured.\n","        Returns (structured_sources, success_bool).\n","        \"\"\"\n","        try:\n","            # Step 1: Search\n","            self.logger.info(f\"[WebSearchAgent] Searching for: {query}\")\n","            raw_results = self.serper_client.search(query, num_results=num_results)\n","\n","            if not raw_results:\n","                self.logger.warning(\"No search results found\")\n","                return [], False\n","\n","            # Step 2: Extract & Structure\n","            self.logger.info(f\"[WebSearchAgent] Extracting {len(raw_results)} results via MCP\")\n","            structured = self.mcp_extractor.extract_structured_context(raw_results)\n","\n","            return structured, True\n","\n","        except Exception as e:\n","            self.logger.error(f\"WebSearchAgent error: {e}\")\n","            return [], False\n","\n","    def format_for_llm(self, structured_sources: List[Dict[str, Any]]) -> str:\n","        \"\"\"\n","        Format structured sources into a readable context string for LLM.\n","        \"\"\"\n","        if not structured_sources:\n","            return \"No sources found.\"\n","\n","        context = \"\\n=== Web Search Results ===\\n\"\n","        for i, source in enumerate(structured_sources, 1):\n","            context += f\"\\n[Source {i}] {source.get('title', 'Untitled')}\\n\"\n","            context += f\"URL: {source.get('url', 'N/A')}\\n\"\n","            context += f\"Summary: {source.get('summary', source.get('snippet', 'N/A'))}\\n\"\n","            context += f\"Authority: {source.get('metadata', {}).get('authority_signal', 0.5):.2f}\\n\"\n","\n","        return context"],"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# === EVALUATION & BENCHMARKING ===\n","# Benchmark agent on JEE dataset and measure performance\n","\n","import pandas as pd\n","import numpy as np\n","from tqdm.auto import tqdm\n","import json\n","from datetime import datetime\n","\n","print('\\n' + '='*60)\n","print('BENCHMARKING MATH RAG AGENT')\n","print('='*60)\n","\n","class BenchmarkRunner:\n","    \"\"\"Run evaluations on agent performance.\"\"\"\n","\n","    def __init__(self, agent, test_questions=None):\n","        self.agent = agent\n","        self.test_questions = test_questions or []\n","        self.results = []\n","\n","    def run_benchmark(self, max_questions=20):\n","        \"\"\"Run benchmark on test questions.\"\"\"\n","        print(f'\\n[1/4] Running benchmark on {min(max_questions, len(self.test_questions))} questions...')\n","\n","        for i, q_dict in enumerate(self.test_questions[:max_questions]):\n","            try:\n","                question = q_dict.get('question', '')\n","                expected = q_dict.get('gold', '')\n","\n","                # Run agent\n","                result = self.agent.route_and_solve(question, use_llm_guard=False)\n","\n","                self.results.append({\n","                    'question': question,\n","                    'expected': expected,\n","                    'predicted': result.get('answer', ''),\n","                    'mode': result.get('mode'),\n","                    'success': True,\n","                    'error': None\n","                })\n","            except Exception as e:\n","                self.results.append({\n","                    'question': q_dict.get('question', ''),\n","                    'expected': q_dict.get('gold', ''),\n","                    'predicted': None,\n","                    'mode': 'error',\n","                    'success': False,\n","                    'error': str(e)[:100]\n","                })\n","\n","            if (i + 1) % 5 == 0:\n","                print(f'  Processed {i + 1}/{min(max_questions, len(self.test_questions))}')\n","\n","    def compute_metrics(self):\n","        \"\"\"Compute performance metrics.\"\"\"\n","        print('\\n[2/4] Computing metrics...')\n","\n","        if not self.results:\n","            print('No results to analyze')\n","            return {}\n","\n","        df = pd.DataFrame(self.results)\n","\n","        total = len(self.results)\n","        success = sum(1 for r in self.results if r['success'])\n","        errors = total - success\n","\n","        # Mode distribution\n","        modes = df[df['success']]['mode'].value_counts().to_dict()\n","\n","        metrics = {\n","            'total_questions': total,\n","            'successful': success,\n","            'errors': errors,\n","            'success_rate': (success / total * 100) if total > 0 else 0,\n","            'mode_distribution': modes,\n","            'timestamp': datetime.now().isoformat()\n","        }\n","\n","        return metrics\n","\n","    def print_report(self, metrics):\n","        \"\"\"Print benchmark report.\"\"\"\n","        print('\\n[3/4] Benchmark Report:')\n","        print(f'  Total Questions: {metrics[\"total_questions\"]}')\n","        print(f'  Successful: {metrics[\"successful\"]}')\n","        print(f'  Errors: {metrics[\"errors\"]}')\n","        print(f'  Success Rate: {metrics[\"success_rate\"]:.1f}%')\n","        print(f'\\n  Mode Distribution:')\n","        for mode, count in metrics['mode_distribution'].items():\n","            pct = (count / metrics['successful'] * 100) if metrics['successful'] > 0 else 0\n","            print(f'    - {mode}: {count} ({pct:.1f}%)')\n","\n","    def save_results(self, filepath='/tmp/benchmark_results.json'):\n","        \"\"\"Save benchmark results to file.\"\"\"\n","        p