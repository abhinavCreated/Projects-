64017099268,"user":{"displayName":"Abhinav Kotar","userId":"00398493030369487425"},"user_tz":-330},"id":"805860e9","outputId":"82cb3552-8089-4e4e-82db-a2dd7e0cdf38"},"outputs":[{"output_type":"stream","name":"stdout","text":["Environment variables loaded.\n"]}],"source":["###Environment Variables (.env)\n","\n","import os\n","from google.colab import userdata\n","\n","from dotenv import load_dotenv\n","load_dotenv()\n","\n","# using Colab Secrets for sensitive information\n","os.environ['OPENAI_API_KEY'] = userdata.get('OPENAI_API_KEY')\n","os.environ['SERPER_API_KEY'] = userdata.get('SERPER_API_KEY')\n","\n","\n","print(\"Environment variables loaded.\")"]},{"cell_type":"code","source":["# main.py\n","# === FastAPI Application for Math Tutor RAG Agent ===\n","\n","from fastapi import FastAPI, HTTPException\n","from pydantic import BaseModel\n","from typing import Optional\n","from datetime import datetime\n","import logging\n","\n","logging.basicConfig(level=logging.INFO)\n","logger = logging.getLogger(__name__)\n","\n","# ============================================================================\n","# REQUEST/RESPONSE MODELS\n","# ============================================================================\n","\n","class SolveRequest(BaseModel):\n","    question: str\n","    question_type: str = \"general\"\n","    use_web_search: bool = False\n","\n","class FeedbackRequest(BaseModel):\n","    question_id: str\n","    question_text: str\n","    agent_response: str\n","    is_correct: bool\n","    question_type: str\n","    error_classification: str = \"\"\n","    user_comment: str = \"\"\n","\n","class SolveResponse(BaseModel):\n","    success: bool\n","    question_id: str\n","    question: str\n","    solution: str\n","    source: str\n","    confidence: float\n","    timestamp: str\n","\n","\n","# ============================================================================\n","# FASTAPI APP (NO DEPRECATED DECORATORS)\n","# ============================================================================\n","\n","app = FastAPI(\n","    title=\"Math Tutor RAG Agent\",\n","    description=\"JEE-level Math problem solver with RAG\",\n","    version=\"1.0.0\"\n",")\n","\n","question_counter = 0\n","\n","# ============================================================================\n","# API ENDPOINTS\n","# ============================================================================\n","\n","@app.get(\"/health\")\n","async def health_check():\n","    return {\n","        \"status\": \"healthy\",\n","        \"service\": \"Math Tutor RAG Agent\",\n","        \"timestamp\": datetime.now().isoformat()\n","    }\n","\n","@app.post(\"/solve\", response_model=SolveResponse)\n","async def solve_math_problem(request: SolveRequest):\n","    global question_counter\n","    question_counter += 1\n","    question_id = f\"Q{question_counter:05d}\"\n","\n","    try:\n","        logger.info(f\"[{question_id}] Solving: {request.question[:80]}...\")\n","\n","        solution = f\"Solution for: {request.question}\\n\\nStep 1: Analyze\\nStep 2: Apply formulas\\nStep 3: Compute\\nAnswer: [computed]\"\n","\n","        return SolveResponse(\n","            success=True,\n","            question_id=question_id,\n","            question=request.question,\n","            solution=solution,\n","            source=\"kb_retrieval\",\n","            confidence=0.85,\n","            timestamp=datetime.now().isoformat()\n","        )\n","    except Exception as e:\n","        logger.error(f\"Error: {e}\")\n","        raise HTTPException(status_code=500, detail=str(e))\n","\n","@app.post(\"/feedback\")\n","async def submit_feedback(request: FeedbackRequest):\n","    try:\n","        logger.info(f\"[{request.question_id}] Feedback: is_correct={request.is_correct}\")\n","        return {\n","            \"success\": True,\n","            \"message\": \"Feedback received\",\n","            \"question_id\": request.question_id,\n","            \"timestamp\": datetime.now().isoformat()\n","        }\n","    except Exception as e:\n","        logger.error(f\"Error: {e}\")\n","        raise HTTPException(status_code=500, detail=str(e))\n","\n","@app.get(\"/stats\")\n","async def get_stats():\n","    return {\n","        \"total_questions\": question_counter,\n","        \"message\": \"Statistics endpoint\"\n","    }\n","\n","logger.info(\"✅ FastAPI App initialized successfully (NO ERRORS!)\")\n","print(\"✅ FastAPI app is ready! Endpoints: /health, /solve, /feedback, /stats\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IOGICMPXbFEG","executionInfo":{"status":"ok","timestamp":1764017119073,"user_tz":-330,"elapsed":1069,"user":{"displayName":"Abhinav Kotar","userId":"00398493030369487425"}},"outputId":"036e0d02-cec7-42ad-f094-7e037c72a6b3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ FastAPI app is ready! Endpoints: /health, /solve, /feedback, /stats\n"]}]},{"cell_type":"markdown","source":["##Guardrails.py\n","Here we'll set up the guardrails for the agent. we give a path to follow and repell any deviations from the desired outcomes."],"metadata":{"id":"wJtaPQIUBaK9"}},{"cell_type":"code","metadata":{"id":"56f0ee92"},"source":["# guardrails.py\n","# === Input/Output Validation & Guardrails for Math Tutor RAG Agent ===\n","# Filters non-math content, ensures educational safety\n","\n","import re\n","import os\n","import logging\n","from typing import Tuple, Dict, Any, Optional\n","from dotenv import load_dotenv\n","\n","try:\n","    from openai import OpenAI\n","    OPENAI_AVAILABLE = True\n","except ImportError:\n","    OPENAI_AVAILABLE = False\n","\n","load_dotenv()\n","logger = logging.getLogger(__name__)\n","\n","# CONFIG\n","OPENAI_API_KEY = os.getenv('OPENAI_API_KEY')\n","LLM_CHECK_ENABLED = True if (OPENAI_API_KEY and OPENAI_AVAILABLE) else False\n","LLM_MODEL = os.getenv('LLM_MODEL', 'gpt-4o-mini')\n","\n","# Math keywords\n","MATH_KEYWORDS = [\n","    r'\\b(solve|equation|integral|derivative|calculus|algebra|geometry|matrix|function|polynomial)\\b',\n","    r'\\b(find|prove|evaluate|simplify|differentiate|integrate|factor|expand)\\b',\n","]\n","\n","# Blocked content patterns\n","BLOCKED_PATTERNS = [\n","    r'\\b(bitcoin|crypto|stock|election|political|covid)\\b',\n","    r'\\b(adult|sexual|graphic|violent|hate|hack|crack|exploit)\\b',\n","]\n","\n","# Suspicious patterns (injection attempts)\n","SUSPICIOUS_PATTERNS = [\n","    r'(sys\\.|__import__|eval|exec)',\n","    r'(<script|javascript:|onerror=)',\n","]\n","\n","def is_likely_math(text: str) -> Tuple[bool, str]:\n","    \"\"\"Check if text contains math keywords/patterns.\"\"\"\n","    text_lower = text.lower()\n","    for pattern in MATH_KEYWORDS:\n","        if re.search(pattern, text_lower, re.IGNORECASE):\n","            return True, f'Found math pattern'\n","    if re.search(r'[0-9]+(\\+|-|\\*|/|\\^|=)[0-9]+', text):\n","        return True, 'Contains numeric expressions'\n","    return False, 'No math patterns detected'\n","\n","def is_blocked_content(text: str) -> Tuple[bool, str]:\n","    \"\"\"Check if text matches blocked patterns.\"\"\"\n","    text_lower = text.lower()\n","    for pattern in BLOCKED_PATTERNS:\n","        if re.search(pattern, text_lower, re.IGNORECASE):\n","            return True, f'Blocked content detected'\n","    return False, ''\n","\n","def is_suspicious_injection(text: str) -> Tuple[bool, str]:\n","    \"\"\"Detect injection attacks.\"\"\"\n","    for pattern in SUSPICIOUS_PATTERNS:\n","        if re.search(pattern, text):\n","            return True, f'Suspicious pattern detected'\n","    return False, ''\n","\n","def is_reasonable_length(text: str, max_length: int = 5000) -> Tuple[bool, str]:\n","    \"\"\"Check input length.\"\"\"\n","    if len(text) > max_length:\n","        return False, f'Question too long'\n","    return True, ''\n","\n","def validate_input(\n","    text: str,\n","    require_math: bool = True,\n","    use_llm: bool = False\n",") -> Tuple[bool, Dict[str, Any]]:\n","    \"\"\"Main validation function.\"\"\"\n","    info = {'valid': False, 'reason': '', 'checks': {}}\n","\n","    # Check length\n","    ok, msg = is_reasonable_length(text)\n","    info['checks']['length'] = {'passed': ok}\n","    if not ok:\n","        info['reason'] = msg\n","        return False, info\n","\n","    # Check injection\n","    ok, msg = is_suspicious_injection(text)\n","    info['checks']['injection'] = {'passed': not ok}\n","    if ok:\n","        info['reason'] = f'Blocked: {msg}'\n","        return False, info\n","\n","    # Check blocked content\n","    ok, msg = is_blocked_content(text)\n","    info['checks']['blocked_content'] = {'passed': not ok}\n","    if ok:\n","        info['reason'] = f'Blocked: {msg}'\n","        return False, info\n","\n","    # Check math intent\n","    if require_math:\n","        is_math, msg = is_likely_math(text)\n","        info['checks']['math_intent'] = {'passed': is_math}\n","        if not is_math:\n","            info['reason'] = f'Not JEE math: {msg}'\n","            return False, info\n","\n","    info['valid'] = True\n","    info['reason'] = 'All checks passed'\n","    return True, info\n","\n","def sanitize_output(response: str, max_length: int = 10000) -> str:\n","    \"\"\"Sanitize LLM output.\"\"\"\n","    if not response:\n","        return 'No response generated.'\n","\n","    if len(response) > max_length:\n","        response = response[:max_length] + '\\n...(truncated)'\n","\n","    response = re.sub(r'<script[^>]*>.*?</script>', '', response, flags=re.IGNORECASE)\n","    response = re.sub(r'on\\w+\\s*=\\s*[\"\\']', '', response)\n","\n","    return response.strip()\n","\n","logger.info('✅ guardrails module loaded successfully')\n"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"806552eb"},"source":["# Agent Module (`agent.py`)\n","\n","This section contains the code that would typically be in your `